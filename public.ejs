<!doctype html><html><head><meta charset="utf-8"><title>Public Challan Search</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-slate-100 p-8"><main class="max-w-3xl mx-auto bg-white p-6 rounded shadow"><h1 class="text-2xl font-bold">Public Challan Search</h1><p class="text-red-600"><%= error %></p><form action="/public/search" method="post" class="flex gap-2 my-4"><input name="query" required placeholder="Vehicle number or challan ID" class="border p-2 flex-1"><button class="bg-blue-700 text-white px-4 rounded">Search</button></form><% if (results) { %><% if (!results.length) { %><p>No matching challans found.</p><% } %><% results.forEach(r => { if (r.challan_id) { %><article class="border rounded p-3 mb-3"><strong>Challan #<%= r.challan_id %></strong><p>Vehicle: <%= r.vehicle_no %> | Owner: <%= r.owner_name %></p><p>Violation: <%= r.violation %> | Fine: ₹<%= r.fine %> | Status: <%= r.status %></p><p><%= r.created_at %></p></article><% } else { %><p>Vehicle <%= r.vehicle_no %>: <%= r.owner_name %> — no challans yet.</p><% } }); %><% } %><a href="/" class="underline">Home</a></main></body></html>
