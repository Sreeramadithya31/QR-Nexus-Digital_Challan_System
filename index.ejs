<!doctype html><html><head><meta charset="utf-8"><title>QR Nexus</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-slate-100 min-h-screen p-8"><main class="max-w-xl mx-auto bg-white p-8 rounded-xl shadow"><h1 class="text-3xl font-bold">QR Nexus 🚦</h1><p class="my-4">QR-linked digital challan prototype.</p><nav class="space-y-2"><p><a class="text-blue-700 underline" href="/public">Public challan search</a></p><p><a class="text-blue-700 underline" href="/login">Official login</a></p><% if (user) { %><p>Signed in as <%= user.username %> (<%= user.role %>) — <a href="/dashboard">Dashboard</a></p><form action="/logout" method="post"><button class="bg-slate-800 text-white px-4 py-2 rounded">Logout</button></form><% } %></nav></main></body></html>
