<!doctype html><html><head><meta charset="utf-8"><title>RTO</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-slate-100 p-8"><main class="max-w-lg mx-auto bg-white p-6 rounded shadow"><h1 class="text-2xl font-bold">RTO Vehicle Registration</h1><p><%= message %></p><form action="/rto/vehicle" method="post" class="space-y-3"><input name="vehicle_no" required placeholder="Vehicle number" class="border p-2 w-full"><input name="owner_name" required placeholder="Owner name (demo data only)" class="border p-2 w-full"><button class="bg-blue-700 text-white p-2 rounded">Create QR record</button></form><% if (qr) { %><img class="mt-4 w-48" src="<%= qr %>" alt="Vehicle QR code"><% } %><a href="/" class="underline block mt-4">Home</a></main></body></html>
