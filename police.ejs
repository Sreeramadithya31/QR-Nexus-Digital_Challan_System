<!doctype html><html><head><meta charset="utf-8"><title>Police</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-slate-100 p-8"><main class="max-w-lg mx-auto bg-white p-6 rounded shadow"><h1 class="text-2xl font-bold">Police Challan Entry</h1><p><%= message %></p><form action="/police/challan" method="post" class="space-y-3"><input name="vehicle_no" required placeholder="Vehicle number" class="border p-2 w-full"><input name="violation" required placeholder="Violation" class="border p-2 w-full"><input name="fine" type="number" min="1" step="0.01" required placeholder="Fine amount" class="border p-2 w-full"><button class="bg-red-700 text-white p-2 rounded">Issue demo challan</button></form><a href="/" class="underline block mt-4">Home</a></main></body></html>
