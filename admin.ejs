<!doctype html><html><head><meta charset="utf-8"><title>Admin</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-slate-100 p-8"><main class="max-w-md mx-auto bg-white p-6 rounded shadow"><h1 class="text-2xl font-bold">Admin Control Panel</h1><p><%= message %></p><form action="/admin/create-user" method="post" class="space-y-3 mt-4"><input name="username" required placeholder="New username" class="border p-2 w-full"><input name="password" type="password" required placeholder="Temporary password" class="border p-2 w-full"><select name="role" class="border p-2 w-full"><option value="rto">RTO</option><option value="police">Police</option></select><button class="bg-purple-700 text-white p-2 rounded w-full">Create account</button></form><p class="mt-4"><a href="/" class="underline">Home</a></p></main></body></html>
